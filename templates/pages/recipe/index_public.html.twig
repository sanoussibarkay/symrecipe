{% extends 'base.html.twig' %}

{% block title %}symrecipe - ingredient
{% endblock %}

{% block body %}
<div class="container mt-5">
  {% if not recipes is same as([]) %}
    <h1>Recette de la communaute</h1>
   
    <div class="d-flex justify-content-center flex-wrap">
       {% for recipe in recipes %}
        <div class="card border-primary m-3 mr-3" style="width: 18rem;">
          <div class="card-header">Recette n°: {{recipe.id}}</div>
            <div class="card-body">
                <h5 class="card-title">{{ recipe.name }}</h5>
                <p class="card-text">{{ recipe.description|slice(0, 100) ~ '...' }}</p>
            </div>
        </div>
       {% endfor %}
    </div>

  {% else %}
    <h1>aucune recette</h1>
  {% endif %}

</div>

{% endblock %}
